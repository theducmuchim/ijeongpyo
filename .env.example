# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# .env.local 은 git에 올라가지 않습니다. 키를 절대 코드에 직접 적지 마세요.

# 구글 AI Studio(https://aistudio.google.com/apikey)에서 받은 키.
# 비워 두면 '시험 모드'로 돌아가서 AI 없이도 화면을 끝까지 눌러 볼 수 있어요.
GEMINI_API_KEY=

# 쓸 모델. 바꾸지 않아도 됩니다. (2.5 모델은 새 키로 쓸 수 없어요)
# 무료 한도: Flash 하루 20번 정도, Flash-Lite 하루 500번 정도 (프로젝트 전체가 나눠 씀)
GEMINI_MODEL=gemini-3.8-flash
# Flash 한도를 다 쓰면 이 모델로 바꿔 부르고, 카드 초안(글만 보냄)은 처음부터 이걸 써요.
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# 휴대폰 한 대가 하루에 부를 수 있는 횟수. 비워 두면 제한 없음(기본).
# 무료 한도는 프로젝트 전체가 나눠 쓰니, 쓰는 사람이 늘면 숫자를 넣어 한 사람이 다 써 버리지 않게 막는다.
DAILY_AI_LIMIT_PER_DEVICE=
DAILY_VOICE_LIMIT_PER_DEVICE=
DAILY_TTS_LIMIT_PER_DEVICE=

# (선택) Vercel에 올릴 때 하루 횟수를 정확히 세려면 Upstash Redis를 연결하세요.
# 비워 두면 서버 메모리로 세는데, 서버가 다시 켜지면 숫자가 초기화돼요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- 처음 가는 길 (세 키 모두 비워 두면 예시 경로로 시험 모드가 돌아가요) ----

# SK open API(https://openapi.sk.com)에서 TMAP 앱 키. 걷는 길과 장소 검색에 써요.
# 경로 결과를 휴대폰에 저장해도 되는지 TMAP에 먼저 물어본 뒤에 넣으세요.
TMAP_APP_KEY=

# 공공데이터포털(https://www.data.go.kr) '소상공인시장진흥공단_상가(상권)정보' 활용신청 후 받은 인증키.
# 꺾는 곳 근처 가게를 찾는 데 써요. 인코딩 키, 디코딩 키 아무거나 넣어도 돼요.
DATA_GO_KR_KEY=

# 카카오 개발자(https://developers.kakao.com) 앱의 'JavaScript 키'. 로드뷰 미리 보기에 써요.
# 브라우저에 보이는 키라서, 카카오 사이트에서 앱 도메인(예: https://ijeongpyo-one.vercel.app)을 꼭 등록하세요.
NEXT_PUBLIC_KAKAO_JS_KEY=
