# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# .env.local 은 git에 올라가지 않습니다. 키를 절대 코드에 직접 적지 마세요.

# 구글 AI Studio(https://aistudio.google.com/apikey)에서 받은 키.
# 비워 두면 '시험 모드'로 돌아가서 AI 없이도 화면을 끝까지 눌러 볼 수 있어요.
GEMINI_API_KEY=

# 쓸 모델. 바꾸지 않아도 됩니다.
GEMINI_MODEL=gemini-2.5-flash

# 휴대폰 한 대가 하루에 AI를 부를 수 있는 횟수.
# 무료 한도는 프로젝트 전체가 나눠 쓰기 때문에, 한 사람이 다 써 버리지 않게 막는 용도예요.
DAILY_AI_LIMIT_PER_DEVICE=10

# (선택) Vercel에 올릴 때 하루 횟수를 정확히 세려면 Upstash Redis를 연결하세요.
# 비워 두면 서버 메모리로 세는데, 서버가 다시 켜지면 숫자가 초기화돼요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
